#
# Timing exceptions of spfi_compress, in terms of its ports and instances. Read the file scoped to the entity, alone or
# with the system inside a larger design: read_xdc -ref spfi_compress spfi_compress.xdc (in a project:
# set_property SCOPED_TO_REF spfi_compress [get_files spfi_compress.xdc]). The clocks come from the design around the
# system, or from spfi_compress_top.xdc when the system is the top level.
#
# The reset input Rst needs no exception: every block that takes it releases it through olo_base_reset_gen, whose scoped
# constraints (the script of Open Logic, below) cut the paths into its synchronisers. The inputs that blocks synchronise
# themselves get a false path through the port, which holds whether the port is a device pin or the pin of the system
# inside a larger design.

# Clocks
set clk_lane [get_clocks -of_objects [get_nets pa0_LaneClk_s]]
set clk_sys  [get_clocks -of_objects [get_ports Clk_sys]]

# Clock crossings of ofb0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_lane -to $clk_sys 6.400

# Clock crossings of ofb0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_sys -to $clk_lane 6.400

