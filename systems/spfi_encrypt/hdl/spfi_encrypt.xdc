#
# Timing exceptions of spfi_encrypt, in terms of its ports and instances. Read the file scoped to the entity, alone or
# with the system inside a larger design: read_xdc -ref spfi_encrypt spfi_encrypt.xdc (in a project:
# set_property SCOPED_TO_REF spfi_encrypt [get_files spfi_encrypt.xdc]). The clocks come from the design around the
# system, or from spfi_encrypt_top.xdc when the system is the top level.
#
# The reset input Rst needs no exception: every block that takes it releases it through olo_base_reset_gen, whose scoped
# constraints (the script of Open Logic, below) cut the paths into its synchronisers. The inputs that blocks synchronise
# themselves get a false path through the port, which holds whether the port is a device pin or the pin of the system
# inside a larger design.

# Clocks
set clk_lane [get_clocks -of_objects [get_pins i_pa0/LaneClk]]
set clk_sys  [get_clocks -of_objects [get_ports Clk_sys]]

# Clock crossings of ofb0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_lane -to $clk_sys 5.000

# Clock crossings of ofb0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_sys -to $clk_lane 5.000

